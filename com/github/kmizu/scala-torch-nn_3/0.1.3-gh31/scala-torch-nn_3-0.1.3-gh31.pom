<?xml version='1.0' encoding='UTF-8'?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.github.kmizu</groupId>
    <artifactId>scala-torch-nn_3</artifactId>
    <packaging>jar</packaging>
    <description>Derived neural network modules, optimizers and checkpoints for scala-torch</description>
    <url>https://github.com/scala-ml/scala-torch</url>
    <version>0.1.3-gh31</version>
    <licenses>
        <license>
            <name>BSD-3-Clause</name>
            <url>https://opensource.org/licenses/BSD-3-Clause</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <name>scala-torch-nn</name>
    <organization>
        <name>Kota Mizushima</name>
        <url>https://github.com/scala-ml/scala-torch</url>
    </organization>
    <scm>
        <url>https://github.com/scala-ml/scala-torch</url>
        <connection>scm:git:https://github.com/scala-ml/scala-torch.git</connection>
        <developerConnection>scm:git:git@github.com:scala-ml/scala-torch.git</developerConnection>
    </scm>
    <developers>
        <developer>
            <id>kmizu</id>
            <name>Kota Mizushima</name>
            <url>https://github.com/kmizu</url>
            <email>kmizu.main@gmail.com</email>
        </developer>
    </developers>
    <properties>
        <info.versionScheme>early-semver</info.versionScheme>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.github.kmizu</groupId>
            <artifactId>scala-torch-autograd_3</artifactId>
            <version>0.1.3-gh31</version>
        </dependency>
        <dependency>
            <groupId>com.github.kmizu</groupId>
            <artifactId>scala-torch-io_3</artifactId>
            <version>0.1.3-gh31</version>
        </dependency>
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala3-library_3</artifactId>
            <version>3.3.8</version>
        </dependency>
        <dependency>
            <groupId>org.scalameta</groupId>
            <artifactId>munit_3</artifactId>
            <version>1.1.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>