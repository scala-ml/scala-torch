// Correctness probe, not a performance kernel. One thread computes one output.
.version 6.0
.target sm_50
.address_size 64
.visible .entry gemm(
  .param .u64 a, .param .u64 b, .param .u64 c,
  .param .u32 m, .param .u32 n, .param .u32 k
) {
  .reg .pred p;
  .reg .b32 r<14>;
  .reg .b64 d<10>;
  .reg .f32 f<4>;
  ld.param.u64 d0, [a];
  ld.param.u64 d1, [b];
  ld.param.u64 d2, [c];
  ld.param.u32 r0, [m];
  ld.param.u32 r1, [n];
  ld.param.u32 r2, [k];
  mov.u32 r3, %tid.x;
  mov.u32 r4, %ctaid.x;
  mov.u32 r5, %ntid.x;
  mad.lo.u32 r6, r4, r5, r3;
  mul.lo.u32 r7, r0, r1;
  setp.ge.u32 p, r6, r7;
  @p bra DONE;
  div.u32 r8, r6, r1;
  rem.u32 r9, r6, r1;
  mov.u32 r10, 0;
  mov.f32 f0, 0f00000000;
LOOP:
  setp.ge.u32 p, r10, r2;
  @p bra STORE;
  mad.lo.u32 r11, r8, r2, r10;
  mad.lo.u32 r12, r10, r1, r9;
  mul.wide.u32 d3, r11, 4;
  mul.wide.u32 d4, r12, 4;
  add.u64 d5, d0, d3;
  add.u64 d6, d1, d4;
  ld.global.f32 f1, [d5];
  ld.global.f32 f2, [d6];
  mul.rn.f32 f3, f1, f2;
  add.rn.f32 f0, f0, f3;
  add.u32 r10, r10, 1;
  bra LOOP;
STORE:
  mul.wide.u32 d7, r6, 4;
  add.u64 d8, d2, d7;
  st.global.f32 [d8], f0;
DONE:
  ret;
}
