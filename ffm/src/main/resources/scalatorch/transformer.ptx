}
.visible .entry attention_fused_fp32(
 .param .u64 query, .param .u64 key, .param .u64 value, .param .u64 output,
 .param .u32 rows, .param .u32 heads, .param .u32 kvheads,
 .param .u32 qtokens, .param .u32 ktokens, .param .u32 width,
 .param .u32 vwidth, .param .u32 storageTokens, .param .f32 scale
) {
 .reg .pred p<4>;
 .reg .b32 r<40>;
 .reg .b64 d<12>;
 .reg .f32 f<12>;
 .shared .align 4 .b8 attention_shared[18432];
 ld.param.u64 d0,[query]; ld.param.u64 d1,[key]; ld.param.u64 d2,[value]; ld.param.u64 d3,[output];
 ld.param.u32 r0,[rows]; ld.param.u32 r1,[heads]; ld.param.u32 r2,[kvheads];
 ld.param.u32 r3,[qtokens]; ld.param.u32 r4,[ktokens]; ld.param.u32 r5,[width];
 ld.param.u32 r6,[vwidth]; ld.param.u32 r7,[storageTokens]; ld.param.f32 f0,[scale];
 mov.u32 r8,%tid.x; mov.u32 r9,%ctaid.x;
 setp.ge.u32 p0,r9,r0; @p0 bra DONE;

 // Decode the flattened (batch, head, query) row and its grouped KV head.
 div.u32 r10,r9,r3; rem.u32 r11,r10,r1; div.u32 r12,r10,r1;
 div.u32 r13,r1,r2; div.u32 r14,r11,r13; mad.lo.u32 r15,r12,r2,r14;
 mul.lo.u32 r16,r9,r5;
 mul.lo.u32 r17,r15,r7; mul.lo.u32 r17,r17,r5;
 mul.lo.u32 r18,r15,r7; mul.lo.u32 r18,r18,r6;

 // Each lane computes scores for keys separated by the CTA width.
 mov.f32 f1,0fFF800000; mov.u32 r19,0; mov.u32 r20,r8;
SCORE_KEYS:
 setp.ge.u32 p0,r20,r4; @p0 bra SCORES_DONE;
 mov.u32 r21,0; mov.f32 f2,0f00000000;
DOT_WIDTH:
 setp.ge.u32 p0,r21,r5; @p0 bra DOT_DONE;
 add.u32 r22,r16,r21; mul.wide.u32 d4,r22,4; add.u64 d5,d0,d4; ld.global.f32 f3,[d5];
 mad.lo.u32 r22,r20,r5,r17; add.u32 r22,r22,r21; mul.wide.u32 d6,r22,4; add.u64 d7,d1,d6; ld.global.f32 f4,[d7];
 fma.rn.f32 f2,f3,f4,f2; add.u32 r21,r21,1; bra DOT_WIDTH;
DOT_DONE:
 mul.rn.f32 f2,f2,f0;
 setp.nan.f32 p1,f2,f2; @p1 mov.u32 r19,1;
 max.f32 f1,f1,f2;
 mul.wide.u32 d4,r20,4; mov.u64 d5,attention_shared; add.u64 d5,d5,d4; st.shared.f32 [d5],f2;
 add.u32 r20,r20,256; bra SCORE_KEYS;
SCORES_DONE:
 // Reduce per-lane maxima and NaN flags in shared memory.
 mov.u64 d4,attention_shared; mul.wide.u32 d5,r8,4; add.u64 d6,d4,16384; add.u64 d6,d6,d5; st.shared.f32 [d6],f1;
 add.u64 d7,d4,17408; add.u64 d7,d7,d5; st.shared.u32 [d7],r19;
 bar.sync 0; mov.u32 r21,128;
MAX_REDUCE:
 setp.eq.u32 p0,r21,0; @p0 bra MAX_DONE;
 setp.ge.u32 p1,r8,r21; @p1 bra MAX_BARRIER;
 mov.u64 d4,attention_shared; mul.wide.u32 d5,r8,4; add.u64 d6,d4,16384; add.u64 d6,d6,d5;
 add.u32 r22,r8,r21; mul.wide.u32 d8,r22,4; add.u64 d9,d4,16384; add.u64 d9,d9,d8;
 ld.shared.f32 f2,[d6]; ld.shared.f32 f3,[d9]; max.f32 f2,f2,f3; st.shared.f32 [d6],f2;
 add.u64 d6,d4,17408; add.u64 d6,d6,d5; add.u64 d9,d4,17408; add.u64 d9,d9,d8;
 ld.shared.u32 r22,[d6]; ld.shared.u32 r23,[d9]; or.b32 r22,r22,r23; st.shared.u32 [d6],r22;
MAX_BARRIER:
 bar.sync 0; shr.u32 r21,r21,1; bra MAX_REDUCE;
MAX_DONE:
 mov.u64 d4,attention_shared; add.u64 d5,d4,16384; ld.shared.f32 f5,[d5];
 add.u64 d5,d4,17408; ld.shared.u32 r19,[d5];

 // Max-subtracted FP32 softmax. Reuse the score array for exponentials.
 mov.u32 r20,r8; mov.f32 f6,0f00000000;
SOFTMAX_KEYS:
 setp.ge.u32 p0,r20,r4; @p0 bra SOFTMAX_DONE;
 mul.wide.u32 d5,r20,4; mov.u64 d6,attention_shared; add.u64 d6,d6,d5; ld.shared.f32 f2,[d6];
 setp.ne.u32 p1,r19,0; @p1 bra SOFTMAX_NAN;
 sub.rn.f32 f2,f2,f5; mul.rn.f32 f2,f2,0f3FB8AA3B; ex2.approx.f32 f2,f2;
 add.rn.f32 f6,f6,f2; bra SOFTMAX_STORE;
SOFTMAX_NAN:
 mov.f32 f2,0f00000000;
SOFTMAX_STORE:
 st.shared.f32 [d6],f2; add.u32 r20,r20,256; bra SOFTMAX_KEYS;
SOFTMAX_DONE:
 mov.u64 d4,attention_shared; mul.wide.u32 d5,r8,4; add.u64 d6,d4,16384; add.u64 d6,d6,d5; st.shared.f32 [d6],f6;
 bar.sync 0; mov.u32 r21,128;
SUM_REDUCE:
 setp.eq.u32 p0,r21,0; @p0 bra SUM_DONE;
 setp.ge.u32 p1,r8,r21; @p1 bra SUM_BARRIER;
 mov.u64 d4,attention_shared; mul.wide.u32 d5,r8,4; add.u64 d6,d4,16384; add.u64 d6,d6,d5;
 add.u32 r22,r8,r21; mul.wide.u32 d8,r22,4; add.u64 d9,d4,16384; add.u64 d9,d9,d8;
 ld.shared.f32 f2,[d6]; ld.shared.f32 f3,[d9]; add.rn.f32 f2,f2,f3; st.shared.f32 [d6],f2;
SUM_BARRIER:
 bar.sync 0; shr.u32 r21,r21,1; bra SUM_REDUCE;
SUM_DONE:
 mov.u64 d4,attention_shared; add.u64 d5,d4,16384; ld.shared.f32 f7,[d5];

 // Each active lane owns one value channel and reduces over all keys.
 setp.ge.u32 p0,r8,r6; @p0 bra DONE;
 mov.u32 r20,0; mov.f32 f8,0f00000000;
VALUE_KEYS:
 setp.ge.u32 p0,r20,r4; @p0 bra VALUE_DONE;
 mul.wide.u32 d5,r20,4; mov.u64 d6,attention_shared; add.u64 d6,d6,d5; ld.shared.f32 f2,[d6];
 mad.lo.u32 r22,r20,r6,r18; add.u32 r22,r22,r8; mul.wide.u32 d7,r22,4; add.u64 d8,d2,d7; ld.global.f32 f3,[d8];
 fma.rn.f32 f8,f2,f3,f8; add.u32 r20,r20,1; bra VALUE_KEYS;
VALUE_DONE:
 setp.ne.u32 p1,r19,0; @p1 bra VALUE_NAN;
 div.rn.f32 f8,f8,f7; bra VALUE_STORE;
VALUE_NAN:
 mov.f32 f8,0f7FC00000;
VALUE_STORE:
 mad.lo.u32 r22,r9,r6,r8; mul.wide.u32 d5,r22,4; add.u64 d6,d3,d5; st.global.f32 [d6],f8;
DONE:
 ret;
}
.visible .entry attention_fused_multiquery_fp32(
 .param .u64 query, .param .u64 key, .param .u64 value, .param .u64 output,
 .param .u32 rows, .param .u32 heads, .param .u32 kvheads,
 .param .u32 qtokens, .param .u32 ktokens, .param .u32 width,
 .param .u32 vwidth, .param .u32 storageTokens, .param .f32 scale
) {
 .reg .pred p<8>;
 .reg .b32 r<48>;
 .reg .b64 d<16>;
 .reg .f32 f<20>;
 // Two 4096-float probability rows plus four 256-entry reduction rows = 36 KiB.
 .shared .align 4 .b8 attention_multiquery_shared[36864];
 ld.param.u64 d0,[query]; ld.param.u64 d1,[key]; ld.param.u64 d2,[value]; ld.param.u64 d3,[output];
 ld.param.u32 r0,[rows]; ld.param.u32 r1,[heads]; ld.param.u32 r2,[kvheads];
 ld.param.u32 r3,[qtokens]; ld.param.u32 r4,[ktokens]; ld.param.u32 r5,[width];
 ld.param.u32 r6,[vwidth]; ld.param.u32 r7,[storageTokens]; ld.param.f32 f0,[scale];
 mov.u32 r8,%tid.x; mov.u32 r9,%ctaid.x; mul.lo.u32 r9,r9,2;
 setp.ge.u32 p0,r9,r0; @p0 bra MQ_DONE;

 // The host only dispatches even qtokens, so paired rows share batch/head/KV head.
 div.u32 r10,r9,r3; rem.u32 r11,r10,r1; div.u32 r12,r10,r1;
 div.u32 r13,r1,r2; div.u32 r14,r11,r13; mad.lo.u32 r15,r12,r2,r14;
 mul.lo.u32 r16,r9,r5; add.u32 r17,r16,r5;
 mul.lo.u32 r18,r15,r7; mul.lo.u32 r18,r18,r6;
 mul.lo.u32 r19,r15,r7; mul.lo.u32 r19,r19,r5;

 // Each lane handles keys strided by 256. Load each K element once and dot it
 // against both query rows, then retain both score rows in shared memory.
 mov.f32 f1,0fFF800000; mov.f32 f2,0fFF800000;
 mov.u32 r20,0; mov.u32 r21,0; mov.u32 r22,0; mov.u32 r20,r8;
MQ_SCORE_KEYS:
 setp.ge.u32 p0,r20,r4; @p0 bra MQ_SCORE_DONE;
 mov.u32 r23,0; mov.f32 f3,0f00000000; mov.f32 f4,0f00000000;
MQ_DOT_WIDTH:
 setp.ge.u32 p0,r23,r5; @p0 bra MQ_DOT_DONE;
 add.u32 r24,r16,r23; mul.wide.u32 d4,r24,4; add.u64 d5,d0,d4; ld.global.f32 f5,[d5];
 add.u32 r24,r17,r23; mul.wide.u32 d4,r24,4; add.u64 d5,d0,d4; ld.global.f32 f6,[d5];
 mul.lo.u32 r24,r20,r5; add.u32 r24,r24,r19; add.u32 r24,r24,r23;
 mul.wide.u32 d6,r24,4; add.u64 d7,d1,d6; ld.global.f32 f7,[d7];
 fma.rn.f32 f3,f5,f7,f3; fma.rn.f32 f4,f6,f7,f4;
 add.u32 r23,r23,1; bra MQ_DOT_WIDTH;
MQ_DOT_DONE:
 mul.rn.f32 f3,f3,f0; mul.rn.f32 f4,f4,f0;
 setp.nan.f32 p1,f3,f3; @p1 mov.u32 r21,1;
 setp.nan.f32 p1,f4,f4; @p1 mov.u32 r22,1;
 max.f32 f1,f1,f3; max.f32 f2,f2,f4;
 mul.wide.u32 d4,r20,4; mov.u64 d5,attention_multiquery_shared; add.u64 d5,d5,d4; st.shared.f32 [d5],f3;
 add.u64 d5,d5,16384; st.shared.f32 [d5],f4;
