 add.u64 d6,d4,33792; add.u64 d6,d6,d5; st.shared.u32 [d6],r21;
 add.u64 d6,d4,34816; add.u64 d6,d6,d5; st.shared.f32 [d6],f2;
 add.u64 d6,d4,35840; add.u64 d6,d6,d5; st.shared.u32 [d6],r22;
