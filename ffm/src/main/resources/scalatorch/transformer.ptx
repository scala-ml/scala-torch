 setp.ge.f64 p,g2,0d3FF8000000000000; @p bra FRACTION;
 mov.f64 g5,0d4000000000000000; mov.f64 g6,g5;
 mov.f64 g7,0d3FE0000000000000; mov.u32 r,0;
SERIES:
 add.rn.f64 g7,g7,0d3FF0000000000000;
 div.rn.f64 g11,g2,g7; mul.rn.f64 g5,g5,g11;
 mov.f64 g8,g6; add.rn.f64 g6,g6,g5;
 // Here g2 < 1.5 and every subsequent positive term decreases. Once
 // rounding stops changing the sum, no later term can change it either.
 setp.eq.f64 p,g6,g8; @p bra SERIES_DONE;
 add.u32 r,r,1; setp.lt.u32 p,r,40; @p bra SERIES;
SERIES_DONE:
 mul.rn.f64 g4,g3,g6; sub.rn.f64 g4,0d3FF0000000000000,g4; bra CDF;
FRACTION:
 add.rn.f64 g7,g2,0d3FE0000000000000;
 div.rn.f64 g5,0d3FF0000000000000,g7;
 mov.f64 g6,0d7E37E43C8800759C; mov.f64 g8,g5; mov.u32 r,0;
CF_LOOP:
 add.u32 r,r,1; cvt.rn.f64.u32 g9,r;
 sub.rn.f64 g11,g9,0d3FE0000000000000; mul.rn.f64 g9,g9,g11; neg.f64 g9,g9;
 add.rn.f64 g7,g7,0d4000000000000000;
 mul.rn.f64 g5,g9,g5; add.rn.f64 g5,g5,g7; div.rn.f64 g5,0d3FF0000000000000,g5;
 div.rn.f64 g6,g9,g6; add.rn.f64 g6,g7,g6;
 mul.rn.f64 g10,g5,g6; mul.rn.f64 g8,g8,g10;
 sub.rn.f64 g11,g10,0d3FF0000000000000; abs.f64 g11,g11;
 setp.lt.f64 p,g11,0d3CE203AF9EE75616; @p bra CF_DONE;
 setp.lt.u32 p,r,128; @p bra CF_LOOP;
CF_DONE:
 mul.rn.f64 g4,g3,g8;
CDF:
 mul.rn.f64 g4,g4,0d3FE0000000000000;
 setp.lt.f64 p,g0,0d0000000000000000; @p bra PRODUCT;
 sub.rn.f64 g4,0d3FF0000000000000,g4;
PRODUCT:
 mul.rn.f64 g4,g0,g4; cvt.rn.f32.f64 f1,g4; bra RETURN;
NEG_ZERO:
