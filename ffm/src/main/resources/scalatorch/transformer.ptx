 mul.wide.u32 d5,r20,4; add.u64 d6,d0,d5; ld.global.f32 f,[d6];
 cvt.f64.f32 g2,f; mul.rn.f64 g3,g1,g2; add.rn.f64 g0,g0,g3;
 add.u32 r19,r19,1; bra WEIGHTED;
STORE:
 mad.lo.u32 r21,r12,r5,r13; mul.wide.u32 d7,r21,4; add.u64 d8,d2,d7;
