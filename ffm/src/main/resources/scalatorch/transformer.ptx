 mul.lo.u32 r17,r17,r5; mul.lo.u32 r18,r12,r5;
 mov.u32 r19,0; mov.f64 g0,0d0000000000000000;
DOT:
 setp.ge.u32 p,r19,r5; @p bra STORE;
 add.u32 r20,r18,r19; mul.wide.u32 d3,r20,4; add.u64 d4,d0,d3;
 add.u32 r21,r17,r19; mul.wide.u32 d5,r21,4; add.u64 d6,d1,d5;
 ld.global.f32 f0,[d4]; ld.global.f32 f1,[d6];
 cvt.f64.f32 g1,f0; cvt.f64.f32 g2,f1;
 mul.rn.f64 g3,g1,g2; add.rn.f64 g0,g0,g3;
