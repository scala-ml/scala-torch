// Float32 weights/gradients with immutable interleaved Double (first,second) moments.
.visible .entry adamw_update(
 .param .u64 aw_weight,.param .u64 aw_gradient,.param .u64 aw_previous,
 .param .u64 aw_output,.param .u64 aw_moments,.param .u64 aw_status,.param .u32 aw_count,
 .param .f64 aw_rate,.param .f64 aw_beta1,.param .f64 aw_beta2,.param .f64 aw_epsilon,
