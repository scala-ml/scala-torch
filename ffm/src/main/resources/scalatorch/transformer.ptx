}

// One thread per row retains the original max/exp/sum/normalization ordering.
.visible .entry attention_prepare(.param .u64 scores, .param .u32 rows, .param .u32 keys) {
 .reg .pred p,pnan,pnew;
 .reg .b32 r<9>;
 .reg .b64 d<3>;
 .reg .f32 f;
 .reg .f64 g<4>;
 ld.param.u64 d0,[scores]; ld.param.u32 r0,[rows]; ld.param.u32 r1,[keys];
 mov.u32 r2,%tid.x; mov.u32 r3,%ctaid.x; mov.u32 r4,%ntid.x;
 mad.lo.u32 r5,r3,r4,r2; setp.ge.u32 p,r5,r0; @p bra DONE;
 mul.lo.u32 r5,r5,r1; mov.u32 r6,0;
 mov.f64 g0,0dFFF0000000000000; setp.ne.u32 pnan,r0,r0;
MAXIMUM:
 setp.ge.u32 p,r6,r1; @p bra EXP_INIT;
 add.u32 r7,r5,r6; mul.wide.u32 d1,r7,8; add.u64 d2,d0,d1;
 ld.global.f64 g1,[d2]; setp.nan.f64 pnew,g1,g1; or.pred pnan,pnan,pnew; max.f64 g0,g0,g1;
 add.u32 r6,r6,1; bra MAXIMUM;
EXP_INIT:
 @pnan mov.f64 g0,0d7FF8000000000000;
 mov.f64 g2,0d0000000000000000; mov.u32 r6,0;
EXP:
 setp.ge.u32 p,r6,r1; @p bra NORMALIZE_INIT;
 add.u32 r7,r5,r6; mul.wide.u32 d1,r7,8; add.u64 d2,d0,d1;
 ld.global.f64 g1,[d2]; sub.rn.f64 g1,g1,g0;
