 div.rn.f64 g11,g11,g12;
 mul.rn.f64 g12,g0,g4; sub.rn.f64 g12,0d3FF0000000000000,g12;
 mul.rn.f64 g12,g7,g12; sub.rn.f64 g12,g12,g11;
 cvt.rn.f32.f64 f0,g12; abs.f32 f2,f0; setp.gtu.f32 p,f2,0f7F7FFFFF; @p bra INVALID;
 add.u64 d7,d3,d6; st.global.f32 [d7],f0;
