 mul.wide.u32 tmp64,kx,dw; add.s64 ix,ix,tmp64;
 setp.lt.s64 p,ix,0; @p bra IC_ZERO;
 cvt.u64.u32 tmp64,w; setp.ge.s64 p,ix,tmp64; @p bra IC_ZERO;
 mad.lo.u32 input_channel,group,cg,channel;
 mad.lo.u32 xi,batch,ci,input_channel; cvt.u32.s64 tmp,iy; mad.lo.u32 xi,xi,h,tmp;
 cvt.u32.s64 tmp,ix; mad.lo.u32 xi,xi,w,tmp;
 mul.wide.u32 offset,xi,4; add.u64 addr,px,offset; ld.global.f32 value,[addr];
 bra IC_STORE;
IC_ZERO:
