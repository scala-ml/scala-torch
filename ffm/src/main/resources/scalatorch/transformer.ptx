 add.u64 d5,d4,35840; ld.shared.u32 r22,[d5];

 // Stable softmax for both rows; score storage is reused for probabilities.
 mov.u32 r20,r8; mov.f32 f7,0f00000000; mov.f32 f8,0f00000000;
MQ_SOFTMAX_KEYS:
 setp.ge.u32 p0,r20,r4; @p0 bra MQ_SOFTMAX_DONE;
 mul.wide.u32 d5,r20,4; mov.u64 d6,attention_multiquery_shared; add.u64 d7,d6,d5; ld.shared.f32 f3,[d7];
