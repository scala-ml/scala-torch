 ld.global.u32 ci,[pg]; ld.global.u32 h,[pg+4]; ld.global.u32 w,[pg+8];
 ld.global.u32 co,[pg+12]; ld.global.u32 cg,[pg+16]; ld.global.u32 kh,[pg+20];
 ld.global.u32 kw,[pg+24]; ld.global.u32 oh,[pg+28]; ld.global.u32 ow,[pg+32];
 ld.global.u32 sh,[pg+36]; ld.global.u32 sw,[pg+40]; ld.global.u32 ph,[pg+44];
 ld.global.u32 pw,[pg+48]; ld.global.u32 dh,[pg+52]; ld.global.u32 dw,[pg+56];
 ld.global.u32 groups,[pg+60];
 rem.u32 ox,idx,ow; div.u32 tmp,idx,ow; rem.u32 oy,tmp,oh;
 div.u32 tmp,tmp,oh; rem.u32 oc,tmp,co; div.u32 batch,tmp,co;
 div.u32 tmp,co,groups; div.u32 first,oc,tmp; mul.lo.u32 first,first,cg;
 mul.lo.u32 positions,kh,kw; mul.lo.u32 total,cg,positions;
 mov.f32 acc,0f00000000; mov.u32 k,lane;
CFW_LOOP:
 setp.ge.u32 p,k,total; @p bra CFW_REDUCE;
 div.u32 ch,k,positions; rem.u32 kernel_index,k,positions;
 div.u32 ky,kernel_index,kw; rem.u32 kx,kernel_index,kw;
 mul.wide.u32 iy,oy,sh; cvt.u64.u32 tmp64,ph; sub.s64 iy,iy,tmp64;
 mul.wide.u32 tmp64,ky,dh; add.s64 iy,iy,tmp64;
 setp.lt.s64 p,iy,0; @p bra CFW_NEXT;
 cvt.u64.u32 tmp64,h; setp.ge.s64 p,iy,tmp64; @p bra CFW_NEXT;
 mul.wide.u32 ix,ox,sw; cvt.u64.u32 tmp64,pw; sub.s64 ix,ix,tmp64;
 mul.wide.u32 tmp64,kx,dw; add.s64 ix,ix,tmp64;
 setp.lt.s64 p,ix,0; @p bra CFW_NEXT;
 cvt.u64.u32 tmp64,w; setp.ge.s64 p,ix,tmp64; @p bra CFW_NEXT;
 add.u32 tmp,first,ch; mad.lo.u32 xi,batch,ci,tmp;
 cvt.u32.s64 tmp,iy; mad.lo.u32 xi,xi,h,tmp;
 cvt.u32.s64 tmp,ix; mad.lo.u32 xi,xi,w,tmp;
 mad.lo.u32 wi,oc,cg,ch; mad.lo.u32 wi,wi,kh,ky; mad.lo.u32 wi,wi,kw,kx;
 mul.wide.u32 offset,xi,4; add.u64 addr,px,offset; ld.global.f32 xf,[addr];
 mul.wide.u32 offset,wi,4; add.u64 addr,pwgt,offset; ld.global.f32 wf,[addr];
 fma.rn.f32 acc,xf,wf,acc;
CFW_NEXT:
 add.u32 k,k,32; bra CFW_LOOP;
CFW_REDUCE:
 shfl.sync.bfly.b32 other,acc,16,31,0xffffffff;
 add.rn.f32 acc,acc,other;
 shfl.sync.bfly.b32 other,acc,8,31,0xffffffff;
 add.rn.f32 acc,acc,other;
 shfl.sync.bfly.b32 other,acc,4,31,0xffffffff;
 add.rn.f32 acc,acc,other;
 shfl.sync.bfly.b32 other,acc,2,31,0xffffffff;
 add.rn.f32 acc,acc,other;
 shfl.sync.bfly.b32 other,acc,1,31,0xffffffff;
 add.rn.f32 acc,acc,other;
 setp.ne.u32 p,lane,0; @p bra CFW_DONE;
