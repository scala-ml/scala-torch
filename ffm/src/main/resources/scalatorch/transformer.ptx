 ld.param.u32 r0,[rows]; ld.param.u32 r1,[width];
 mov.u32 r2,%tid.x; mov.u32 r3,%ctaid.x; mov.u32 r4,%ntid.x;
 mad.lo.u32 r5,r3,r4,r2; setp.ge.u32 p,r5,r1; @p bra DONE;
 mov.u32 r6,0; mov.f64 g3,0d0000000000000000;
REDUCE:
 setp.ge.u32 p,r6,r0; @p bra STORE;
 mad.lo.u32 r7,r6,r1,r5; mul.wide.u32 d4,r7,4; add.u64 d5,d0,d4; add.u64 d6,d1,d4;
 mul.wide.u32 d4,r6,8; add.u64 d7,d2,d4;
 ld.global.f32 f0,[d5]; ld.global.f32 f1,[d6]; ld.global.f64 g2,[d7];
 cvt.f64.f32 g0,f1; cvt.f64.f32 g1,f0;
 mul.rn.f64 g0,g0,g1; mul.rn.f64 g0,g0,g2; add.rn.f64 g3,g3,g0;
 add.u32 r6,r6,1; bra REDUCE;
STORE:
 mul.wide.u32 d4,r5,4; add.u64 d5,d3,d4; cvt.rn.f32.f64 f0,g3; st.global.f32 [d5],f0;
DONE:
 ret;
}

.visible .entry rmsnorm(
 .param .u64 a, .param .u64 weight, .param .u64 out,
 .param .u32 rows, .param .u32 width, .param .f64 epsilon
) {
 .reg .pred p;
 .reg .b32 r<10>;
 .reg .b64 d<9>;
 .reg .f32 f<3>;
 .reg .f64 g<8>;
 ld.param.u64 d0,[a]; ld.param.u64 d1,[weight]; ld.param.u64 d2,[out];
 ld.param.u32 r0,[rows]; ld.param.u32 r1,[width]; ld.param.f64 g0,[epsilon];
 mov.u32 r2,%tid.x; mov.u32 r3,%ctaid.x; mov.u32 r4,%ntid.x;
 mad.lo.u32 r5,r3,r4,r2;
 setp.ge.u32 p,r5,r0; @p bra DONE;
 mul.lo.u32 r6,r5,r1;
 mov.u32 r7,0; mov.f64 g1,0d0000000000000000;
SUM:
 setp.ge.u32 p,r7,r1; @p bra INVERSE;
 add.u32 r8,r6,r7; mul.wide.u32 d3,r8,4; add.u64 d4,d0,d3;
 ld.global.f32 f0,[d4]; cvt.f64.f32 g2,f0;
 mul.rn.f64 g3,g2,g2; add.rn.f64 g1,g1,g3;
 add.u32 r7,r7,1; bra SUM;
INVERSE:
 cvt.rn.f64.u32 g4,r1; div.rn.f64 g1,g1,g4; add.rn.f64 g1,g1,g0;
 sqrt.rn.f64 g1,g1; div.rn.f64 g1,0d3FF0000000000000,g1;
 mov.u32 r7,0;
OUTPUT:
 setp.ge.u32 p,r7,r1; @p bra DONE;
 add.u32 r8,r6,r7; mul.wide.u32 d3,r8,4; add.u64 d4,d0,d3;
 add.u64 d5,d2,d3; mul.wide.u32 d6,r7,4; add.u64 d7,d1,d6;
 ld.global.f32 f0,[d4]; ld.global.f32 f1,[d7];
 cvt.f64.f32 g2,f0; cvt.f64.f32 g3,f1;
 mul.rn.f64 g2,g2,g1; mul.rn.f64 g2,g2,g3;
 cvt.rn.f32.f64 f2,g2; st.global.f32 [d5],f2;
 add.u32 r7,r7,1; bra OUTPUT;
