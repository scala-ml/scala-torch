 mov.u64 d4,attention_multiquery_shared; mul.wide.u32 d5,r8,4; add.u32 r24,r8,r23; mul.wide.u32 d6,r24,4;
 add.u64 d7,d4,32768; add.u64 d7,d7,d5; add.u64 d8,d4,32768; add.u64 d8,d8,d6;
 ld.shared.f32 f3,[d7]; ld.shared.f32 f4,[d8]; max.f32 f3,f3,f4; st.shared.f32 [d7],f3;
 add.u64 d7,d4,33792; add.u64 d7,d7,d5; add.u64 d8,d4,33792; add.u64 d8,d8,d6;
 ld.shared.u32 r25,[d7]; ld.shared.u32 r26,[d8]; or.b32 r25,r25,r26; st.shared.u32 [d7],r25;
 add.u64 d7,d4,34816; add.u64 d7,d7,d5; add.u64 d8,d4,34816; add.u64 d8,d8,d6;
 ld.shared.f32 f3,[d7]; ld.shared.f32 f4,[d8]; max.f32 f3,f3,f4; st.shared.f32 [d7],f3;
 add.u64 d7,d4,35840; add.u64 d7,d7,d5; add.u64 d8,d4,35840; add.u64 d8,d8,d6;
 ld.shared.u32 r25,[d7]; ld.shared.u32 r26,[d8]; or.b32 r25,r25,r26; st.shared.u32 [d7],r25;
MQ_MAX_BARRIER:
 bar.sync 0; shr.u32 r23,r23,1; bra MQ_MAX_REDUCE;
MQ_MAX_DONE:
 mov.u64 d4,attention_multiquery_shared; add.u64 d5,d4,32768; ld.shared.f32 f5,[d5];
 add.u64 d5,d4,33792; ld.shared.u32 r21,[d5];
