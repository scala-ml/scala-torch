 add.u32 r7,r5,r6; mul.wide.u32 d1,r7,8; add.u64 d2,d0,d1;
 ld.global.f64 g1,[d2]; div.rn.f64 g1,g1,g2; st.global.f64 [d2],g1;
 add.u32 r6,r6,1; bra NORMALIZE;
DONE:
 ret;
}
// One thread per output channel. Each key reduction preserves serial order.
.visible .entry attention_output(
 .param .u64 value, .param .u64 probabilities, .param .u64 output,
 .param .u32 count, .param .u32 heads, .param .u32 kvheads,
 .param .u32 qtokens, .param .u32 ktokens, .param .u32 vwidth,
 .param .u32 storageTokens, .param .u32 row_offset
