// One warp per output for FP32 inference. Lanes split the input-channel/kernel
// reduction, then use a butterfly sum; lane zero owns the output store.
.visible .entry conv2d_fast(.param .u64 c_x, .param .u64 c_w, .param .u64 c_out,
 .param .u64 c_geometry, .param .u32 c_count) {
 .reg .pred p;
