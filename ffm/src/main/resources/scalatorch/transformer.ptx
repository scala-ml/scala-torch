// Private math helpers: exp for finite nonpositive arguments; log for [1, Int.MaxValue].
.func (.param .f64 ce_result) ce_exp(.param .f64 ce_input) {
 .reg .pred p;
 .reg .b32 r<8>;
 .reg .b64 d<7>;
 .reg .f64 g<7>;
 ld.param.f64 g1,[ce_input];
 setp.lt.f64 p,g1,0dC087500000000000; @p bra EXP_ZERO;
 // exp(x), x=-abs(input): x = n*ln(2) + r, |r| <= ln(2)/2.
 // Split ln(2) avoids cancellation; degree-12 Taylor evaluated in Double.
 mul.rn.f64 g2,g1,0d3FF71547652B82FE;
