// Reference inference kernels. No tiling or performance claims.
.version 6.0
.target sm_50
.address_size 64

.visible .entry attention_gradient_cast(.param .u64 a, .param .u64 out, .param .u32 count) {
 .reg .pred p;
 .reg .b32 r<5>;
 .reg .b64 d<5>;
 .reg .f64 g;
 .reg .f32 f;
 ld.param.u64 d0,[a]; ld.param.u64 d1,[out]; ld.param.u32 r0,[count];
 mov.u32 r1,%tid.x; mov.u32 r2,%ctaid.x; mov.u32 r3,%ntid.x;
 mad.lo.u32 r4,r2,r3,r1; setp.ge.u32 p,r4,r0; @p bra DONE;
 mul.wide.u32 d2,r4,8; add.u64 d3,d0,d2; ld.global.f64 g,[d3];
 mul.wide.u32 d2,r4,4; add.u64 d4,d1,d2; cvt.rn.f32.f64 f,g; st.global.f32 [d4],f;
DONE:
 ret;
}

// One worker owns each batch/KV-head group. All accumulation is Double and race-free.
.visible .entry attention_backward(
 .param .u64 query, .param .u64 key, .param .u64 value, .param .u64 upstream,
 .param .u64 dq, .param .u64 dk, .param .u64 dv, .param .u64 probabilities, .param .u64 dp,
 .param .u32 groups, .param .u32 heads, .param .u32 kvheads, .param .u32 qtokens,
 .param .u32 ktokens, .param .u32 width, .param .u32 vwidth, .param .u32 start, .param .f64 attention_scale
) {
 .reg .pred p,pnan,pnew;
 .reg .b32 r<30>;
 .reg .b64 d<18>;
 .reg .f32 f<3>;
 .reg .f64 g<12>;
 ld.param.u64 d0,[query]; ld.param.u64 d1,[key]; ld.param.u64 d2,[value]; ld.param.u64 d3,[upstream];
 ld.param.u64 d4,[dq]; ld.param.u64 d5,[dk]; ld.param.u64 d6,[dv];
 ld.param.u64 d7,[probabilities]; ld.param.u64 d8,[dp];
 ld.param.u32 r0,[groups]; ld.param.u32 r1,[heads]; ld.param.u32 r2,[kvheads]; ld.param.u32 r3,[qtokens];
 ld.param.u32 r4,[ktokens]; ld.param.u32 r5,[width]; ld.param.u32 r6,[vwidth]; ld.param.u32 r7,[start];
 ld.param.f64 g0,[attention_scale];
 mov.u32 r8,%tid.x; mov.u32 r9,%ctaid.x; mov.u32 r10,%ntid.x;
 mad.lo.u32 r11,r9,r10,r8; setp.ge.u32 p,r11,r0; @p bra DONE;
 div.u32 r12,r11,r2; rem.u32 r13,r11,r2; div.u32 r14,r1,r2;
 mul.lo.u32 r15,r13,r14; add.u32 r16,r15,r14; mul.lo.u32 r17,r11,r4;
HEAD:
 setp.ge.u32 p,r15,r16; @p bra DONE;
 mov.u32 r18,0;
TOKEN:
 setp.ge.u32 p,r18,r3; @p bra NEXT_HEAD;
 mad.lo.u32 r19,r12,r1,r15; mad.lo.u32 r19,r19,r3,r18;
 mul.lo.u32 r20,r19,r5; mul.lo.u32 r21,r19,r6;
 cvt.u64.u32 d9,r7; cvt.u64.u32 d10,r18; add.u64 d9,d9,d10; add.u64 d9,d9,1;
 cvt.u64.u32 d10,r4; min.u64 d9,d9,d10; cvt.u32.u64 r22,d9;
 mov.u32 r23,0; mov.f64 g1,0dFFF0000000000000; setp.ne.u32 pnan,r0,r0;
SCORES:
 setp.ge.u32 p,r23,r22; @p bra EXP_START;
 mov.u32 r24,0; mov.f64 g2,0d0000000000000000;
DOT:
 setp.ge.u32 p,r24,r5; @p bra SCORE_STORE;
 add.u32 r25,r20,r24; add.u32 r26,r17,r23; mad.lo.u32 r26,r26,r5,r24;
 mul.wide.u32 d9,r25,4; add.u64 d10,d0,d9; mul.wide.u32 d9,r26,4; add.u64 d11,d1,d9;
 ld.global.f32 f0,[d10]; ld.global.f32 f1,[d11]; cvt.f64.f32 g3,f0; cvt.f64.f32 g4,f1;
 mul.rn.f64 g3,g3,g4; add.rn.f64 g2,g2,g3; add.u32 r24,r24,1; bra DOT;
SCORE_STORE:
 mul.rn.f64 g2,g2,g0; add.u32 r25,r17,r23; mul.wide.u32 d9,r25,8; add.u64 d10,d7,d9;
 st.global.f64 [d10],g2; setp.nan.f64 pnew,g2,g2; or.pred pnan,pnan,pnew; max.f64 g1,g1,g2;
 add.u32 r23,r23,1; bra SCORES;
EXP_START:
 @pnan mov.f64 g1,0d7FF8000000000000;
 mov.u32 r23,0; mov.f64 g5,0d0000000000000000;
EXP:
 setp.ge.u32 p,r23,r22; @p bra NORMALIZE_START;
 add.u32 r25,r17,r23; mul.wide.u32 d9,r25,8; add.u64 d10,d7,d9; add.u64 d12,d8,d9;
 ld.global.f64 g2,[d10]; sub.rn.f64 g2,g2,g1;
 cvt.rn.f32.f64 f0,g2; mul.rn.f32 f0,f0,0f3FB8AA3B; ex2.approx.f32 f0,f0;
 cvt.f64.f32 g2,f0; st.global.f64 [d10],g2; add.rn.f64 g5,g5,g2;
 mov.u32 r24,0; mov.f64 g6,0d0000000000000000;
DP_DOT:
 setp.ge.u32 p,r24,r6; @p bra DP_STORE;
 add.u32 r25,r21,r24; add.u32 r26,r17,r23; mad.lo.u32 r26,r26,r6,r24;
 mul.wide.u32 d9,r25,4; add.u64 d10,d3,d9; mul.wide.u32 d9,r26,4; add.u64 d11,d2,d9;
 ld.global.f32 f0,[d10]; ld.global.f32 f1,[d11]; cvt.f64.f32 g3,f0; cvt.f64.f32 g4,f1;
 mul.rn.f64 g3,g3,g4; add.rn.f64 g6,g6,g3; add.u32 r24,r24,1; bra DP_DOT;
DP_STORE:
 st.global.f64 [d12],g6; add.u32 r23,r23,1; bra EXP;
NORMALIZE_START:
 mov.u32 r23,0; mov.f64 g7,0d0000000000000000;
NORMALIZE:
 setp.ge.u32 p,r23,r22; @p bra GRAD_START;
 add.u32 r25,r17,r23; mul.wide.u32 d9,r25,8; add.u64 d10,d7,d9; add.u64 d11,d8,d9;
 ld.global.f64 g2,[d10]; div.rn.f64 g2,g2,g5; st.global.f64 [d10],g2;
 ld.global.f64 g6,[d11]; mul.rn.f64 g6,g6,g2; add.rn.f64 g7,g7,g6;
 add.u32 r23,r23,1; bra NORMALIZE;
GRAD_START:
 mov.u32 r23,0;
GRAD:
 setp.ge.u32 p,r23,r22; @p bra NEXT_TOKEN;
 add.u32 r25,r17,r23; mul.wide.u32 d9,r25,8; add.u64 d10,d7,d9; add.u64 d11,d8,d9;
 ld.global.f64 g2,[d10]; ld.global.f64 g6,[d11]; sub.rn.f64 g6,g6,g7;
 mul.rn.f64 g8,g2,g6; mul.rn.f64 g8,g8,g0; mov.u32 r24,0;
QK:
 setp.ge.u32 p,r24,r5; @p bra V_START;
 add.u32 r25,r20,r24; add.u32 r26,r17,r23; mad.lo.u32 r26,r26,r5,r24;
 mul.wide.u32 d9,r25,4; add.u64 d10,d0,d9; mul.wide.u32 d9,r26,4; add.u64 d11,d1,d9;
 mul.wide.u32 d9,r25,8; add.u64 d12,d4,d9; mul.wide.u32 d9,r26,8; add.u64 d13,d5,d9;
 ld.global.f32 f0,[d10]; ld.global.f32 f1,[d11]; cvt.f64.f32 g3,f0; cvt.f64.f32 g4,f1;
 ld.global.f64 g9,[d12]; mul.rn.f64 g10,g8,g4; add.rn.f64 g9,g9,g10; st.global.f64 [d12],g9;
 ld.global.f64 g9,[d13]; mul.rn.f64 g10,g8,g3; add.rn.f64 g9,g9,g10; st.global.f64 [d13],g9;
 add.u32 r24,r24,1; bra QK;
V_START:
 mov.u32 r24,0;
V:
 setp.ge.u32 p,r24,r6; @p bra NEXT_KEY;
 add.u32 r25,r21,r24; add.u32 r26,r17,r23; mad.lo.u32 r26,r26,r6,r24;
 mul.wide.u32 d9,r25,4; add.u64 d10,d3,d9; mul.wide.u32 d9,r26,8; add.u64 d11,d6,d9;
 ld.global.f32 f0,[d10]; cvt.f64.f32 g3,f0; mul.rn.f64 g3,g2,g3;
 ld.global.f64 g9,[d11]; add.rn.f64 g9,g9,g3; st.global.f64 [d11],g9;
 add.u32 r24,r24,1; bra V;
NEXT_KEY:
 add.u32 r23,r23,1; bra GRAD;
NEXT_TOKEN:
 add.u32 r18,r18,1; bra TOKEN;
NEXT_HEAD:
 add.u32 r15,r15,1; bra HEAD;
DONE:
 ret;
}

// One owner per output element; occurrence lists preserve logical token order.
.visible .entry embedding_backward(.param .u64 gradient, .param .u64 heads, .param .u64 next,
 .param .u64 out, .param .u32 count, .param .u32 width) {
 .reg .pred p;
 .reg .b32 r<11>;
 .reg .b64 d<7>;
 .reg .f32 f<2>;
 ld.param.u64 d0,[gradient]; ld.param.u64 d1,[heads]; ld.param.u64 d2,[next]; ld.param.u64 d3,[out];
 ld.param.u32 r0,[count]; ld.param.u32 r1,[width];
 mov.u32 r2,%tid.x; mov.u32 r3,%ctaid.x; mov.u32 r4,%ntid.x;
 mad.lo.u32 r5,r3,r4,r2; setp.ge.u32 p,r5,r0; @p bra DONE;
 div.u32 r6,r5,r1; rem.u32 r7,r5,r1;
 mul.wide.u32 d4,r6,4; add.u64 d5,d1,d4; ld.global.s32 r8,[d5];
 mov.f32 f0,0f00000000;
REDUCE:
 setp.lt.s32 p,r8,0; @p bra STORE;
 mad.lo.u32 r9,r8,r1,r7; mul.wide.u32 d4,r9,4; add.u64 d5,d0,d4;
 ld.global.f32 f1,[d5]; add.rn.f32 f0,f0,f1;
 mul.wide.u32 d4,r8,4; add.u64 d6,d2,d4; ld.global.s32 r8,[d6]; bra REDUCE;
STORE:
 mul.wide.u32 d4,r5,4; add.u64 d5,d3,d4; st.global.f32 [d5],f0;
DONE:
 ret;
}

.visible .entry fill(.param .u64 out, .param .u32 count, .param .f32 value) {
 .reg .pred p;
 .reg .b32 r<5>;
 .reg .b64 d<3>;
 .reg .f32 f;
 ld.param.u64 d0,[out]; ld.param.u32 r0,[count]; ld.param.f32 f,[value];
 mov.u32 r1,%tid.x; mov.u32 r2,%ctaid.x; mov.u32 r3,%ntid.x;
 mad.lo.u32 r4,r2,r3,r1; setp.ge.u32 p,r4,r0; @p bra DONE;
 mul.wide.u32 d1,r4,4; add.u64 d2,d0,d1; st.global.f32 [d2],f;
DONE:
 ret;
}

.visible .entry expand_scalar(.param .u64 a, .param .u64 out, .param .u32 count) {
 .reg .pred p;
 .reg .b32 r<5>;
 .reg .b64 d<4>;
 .reg .f32 f;
 ld.param.u64 d0,[a]; ld.param.u64 d1,[out]; ld.param.u32 r0,[count];
 mov.u32 r1,%tid.x; mov.u32 r2,%ctaid.x; mov.u32 r3,%ntid.x;
 mad.lo.u32 r4,r2,r3,r1; setp.ge.u32 p,r4,r0; @p bra DONE;
 ld.global.f32 f,[d0]; mul.wide.u32 d2,r4,4; add.u64 d3,d1,d2;
 st.global.f32 [d3],f;
DONE:
 ret;
}

// Serial reference reduction; no throughput claim.
.visible .entry sum(.param .u64 a, .param .u64 out, .param .u32 count) {
 .reg .pred p;
 .reg .b32 r<4>;
 .reg .b64 d<4>;
 .reg .f32 f;
 .reg .f64 g<2>;
 mov.u32 r0,%tid.x; setp.ne.u32 p,r0,0; @p bra DONE;
 mov.u32 r0,%ctaid.x; setp.ne.u32 p,r0,0; @p bra DONE;
 ld.param.u64 d0,[a]; ld.param.u64 d1,[out]; ld.param.u32 r1,[count];
 mov.u32 r2,0; mov.f64 g0,0d0000000000000000;
LOOP:
 setp.ge.u32 p,r2,r1; @p bra STORE;
 mul.wide.u32 d2,r2,4; add.u64 d3,d0,d2; ld.global.f32 f,[d3];
 cvt.f64.f32 g1,f; add.rn.f64 g0,g0,g1;
 add.u32 r2,r2,1; bra LOOP;
STORE:
 cvt.rn.f32.f64 f,g0; st.global.f32 [d1],f;
DONE:
 ret;
}

.visible .entry scale(.param .u64 a, .param .u64 out, .param .u32 count, .param .f32 scalar) {
 .reg .pred p;
 .reg .b32 r<5>;
 .reg .b64 d<5>;
 .reg .f32 f<3>;
 ld.param.u64 d0,[a]; ld.param.u64 d1,[out]; ld.param.u32 r0,[count];
 ld.param.f32 f1,[scalar];
 mov.u32 r1,%tid.x; mov.u32 r2,%ctaid.x; mov.u32 r3,%ntid.x;
 mad.lo.u32 r4,r2,r3,r1;
 setp.ge.u32 p,r4,r0; @p bra DONE;
 mul.wide.u32 d2,r4,4; add.u64 d3,d0,d2; add.u64 d4,d1,d2;
 ld.global.f32 f0,[d3]; mul.rn.f32 f2,f0,f1;
 st.global.f32 [d4],f2;
DONE:
 ret;
}

.visible .entry binary(
 .param .u64 a, .param .u64 b, .param .u64 out, .param .u32 count, .param .u32 op
) {
 .reg .pred p;
 .reg .b32 r<7>;
 .reg .b64 d<7>;
 .reg .f32 f<3>;
 ld.param.u64 d0,[a]; ld.param.u64 d1,[b]; ld.param.u64 d2,[out];
 ld.param.u32 r0,[count]; ld.param.u32 r1,[op];
 mov.u32 r2,%tid.x; mov.u32 r3,%ctaid.x; mov.u32 r4,%ntid.x;
 mad.lo.u32 r5,r3,r4,r2;
 setp.ge.u32 p,r5,r0; @p bra DONE;
 mul.wide.u32 d3,r5,4;
 add.u64 d4,d0,d3; add.u64 d5,d1,d3; add.u64 d6,d2,d3;
 ld.global.f32 f0,[d4]; ld.global.f32 f1,[d5];
 setp.eq.u32 p,r1,0; @p bra ADD;
 mul.rn.f32 f2,f0,f1; bra STORE;
ADD:
 add.rn.f32 f2,f0,f1;
STORE:
 st.global.f32 [d6],f2;
DONE:
 ret;
}

.visible .entry silu(.param .u64 a, .param .u64 out, .param .u32 count, .param .u64 upstream, .param .u32 backward) {
 .reg .pred p;
 .reg .b32 r<9>;
 .reg .b64 d<9>;
 .reg .f32 f<5>;
 .reg .f64 g<8>;
 ld.param.u64 d0,[a]; ld.param.u64 d1,[out]; ld.param.u32 r0,[count];
 ld.param.u64 d7,[upstream]; ld.param.u32 r8,[backward];
 mov.u32 r1,%tid.x; mov.u32 r2,%ctaid.x; mov.u32 r3,%ntid.x;
 mad.lo.u32 r4,r2,r3,r1;
 setp.ge.u32 p,r4,r0; @p bra DONE;
 mul.wide.u32 d2,r4,4; add.u64 d3,d0,d2; add.u64 d4,d1,d2;
 ld.global.f32 f0,[d3];
 setp.eq.f32 p,f0,0fFF800000; @p bra NEG_INF;
 cvt.f64.f32 g0,f0;
 setp.nan.f64 p,g0,g0; @p bra NAN_VALUE;
 abs.f64 g1,g0; neg.f64 g1,g1;
 setp.lt.f64 p,g1,0dC087500000000000; @p bra EXP_ZERO;
 // exp(x), x=-abs(input): x = n*ln(2) + r, |r| <= ln(2)/2.
 // Split ln(2) avoids cancellation; degree-12 Taylor evaluated in Double.
 mul.rn.f64 g2,g1,0d3FF71547652B82FE;
 cvt.rni.s32.f64 r5,g2; cvt.rn.f64.s32 g3,r5;
 mul.rn.f64 g2,g3,0d3FE62E42FEE00000; sub.rn.f64 g2,g1,g2;
 mul.rn.f64 g3,g3,0d3DEA39EF35793C76; sub.rn.f64 g2,g2,g3;
 mov.f64 g4,0d3E21EED8EFF8D898;
 fma.rn.f64 g4,g4,g2,0d3E5AE64567F544E4;
 fma.rn.f64 g4,g4,g2,0d3E927E4FB7789F5C;
 fma.rn.f64 g4,g4,g2,0d3EC71DE3A556C734;
 fma.rn.f64 g4,g4,g2,0d3EFA01A01A01A01A;
 fma.rn.f64 g4,g4,g2,0d3F2A01A01A01A01A;
 fma.rn.f64 g4,g4,g2,0d3F56C16C16C16C17;
 fma.rn.f64 g4,g4,g2,0d3F81111111111111;
 fma.rn.f64 g4,g4,g2,0d3FA5555555555555;
 fma.rn.f64 g4,g4,g2,0d3FC5555555555555;
 fma.rn.f64 g4,g4,g2,0d3FE0000000000000;
 fma.rn.f64 g4,g4,g2,0d3FF0000000000000;
 fma.rn.f64 g4,g4,g2,0d3FF0000000000000;
 // Split the power of two into normal Double factors, including subnormal exp(x).
 shr.s32 r6,r5,1; sub.s32 r7,r5,r6;
 add.s32 r6,r6,1023; add.s32 r7,r7,1023;
 cvt.u64.u32 d5,r6; cvt.u64.u32 d6,r7;
 shl.b64 d5,d5,52; shl.b64 d6,d6,52;
 mov.b64 g5,d5; mov.b64 g6,d6;
 mul.rn.f64 g4,g4,g5; mul.rn.f64 g4,g4,g6;
 bra SIGMOID;
EXP_ZERO:
 mov.f64 g4,0d0000000000000000;
SIGMOID:
 add.rn.f64 g5,g4,0d3FF0000000000000;
 setp.lt.f32 p,f0,0f00000000; @p bra NEGATIVE;
 div.rn.f64 g6,0d3FF0000000000000,g5; bra PRODUCT;
NEGATIVE:
 div.rn.f64 g6,g4,g5;
PRODUCT:
 setp.ne.u32 p,r8,0; @p bra DERIVATIVE;
 mul.rn.f64 g7,g0,g6; cvt.rn.f32.f64 f4,g7; bra STORE;
DERIVATIVE:
 setp.eq.f64 p,g6,0d0000000000000000; @p bra GRAD_ZERO;
 setp.eq.f64 p,g6,0d3FF0000000000000; @p bra UPSTREAM;
 sub.rn.f64 g7,0d3FF0000000000000,g6;
 mul.rn.f64 g7,g0,g7; add.rn.f64 g7,g7,0d3FF0000000000000;
 mul.rn.f64 g6,g6,g7;
 setp.eq.f64 p,g6,0d0000000000000000; @p bra GRAD_ZERO;
UPSTREAM:
 add.u64 d8,d7,d2; ld.global.f32 f1,[d8]; cvt.f64.f32 g7,f1;
 mul.rn.f64 g7,g7,g6; cvt.rn.f32.f64 f4,g7; bra STORE;
GRAD_ZERO:
 mov.f32 f4,0f00000000; bra STORE;
NAN_VALUE:
 mov.f32 f4,f0; bra STORE;
NEG_INF:
 setp.ne.u32 p,r8,0; @p bra GRAD_ZERO;
 mov.f32 f4,0f80000000;
STORE:
