// Reference inference kernels. No tiling or performance claims.
.version 6.0
.target sm_50
.address_size 64

.visible .entry binary(
 .param .u64 a, .param .u64 b, .param .u64 out, .param .u32 count, .param .u32 op
) {
 .reg .pred p;
 .reg .b32 r<7>;
 .reg .b64 d<7>;
 .reg .f32 f<3>;
 ld.param.u64 d0,[a]; ld.param.u64 d1,[b]; ld.param.u64 d2,[out];
 ld.param.u32 r0,[count]; ld.param.u32 r1,[op];
 mov.u32 r2,%tid.x; mov.u32 r3,%ctaid.x; mov.u32 r4,%ntid.x;
 mad.lo.u32 r5,r3,r4,r2;
 setp.ge.u32 p,r5,r0; @p bra DONE;
 mul.wide.u32 d3,r5,4;
 add.u64 d4,d0,d3; add.u64 d5,d1,d3; add.u64 d6,d2,d3;
 ld.global.f32 f0,[d4]; ld.global.f32 f1,[d5];
 setp.eq.u32 p,r1,0; @p bra ADD;
 mul.rn.f32 f2,f0,f1; bra STORE;
ADD:
 add.rn.f32 f2,f0,f1;
STORE:
 st.global.f32 [d6],f2;
DONE:
 ret;
}

.visible .entry silu(.param .u64 a, .param .u64 out, .param .u32 count) {
 .reg .pred p;
 .reg .b32 r<5>;
 .reg .b64 d<5>;
 .reg .f32 f<5>;
 ld.param.u64 d0,[a]; ld.param.u64 d1,[out]; ld.param.u32 r0,[count];
 mov.u32 r1,%tid.x; mov.u32 r2,%ctaid.x; mov.u32 r3,%ntid.x;
 mad.lo.u32 r4,r2,r3,r1;
 setp.ge.u32 p,r4,r0; @p bra DONE;
 mul.wide.u32 d2,r4,4; add.u64 d3,d0,d2; add.u64 d4,d1,d2;
 ld.global.f32 f0,[d3];
 setp.eq.f32 p,f0,0fFF800000; @p bra NEG_INF;
 abs.f32 f1,f0;
 mul.rn.f32 f1,f1,0fBFB8AA3B; // -log2(e)
 ex2.approx.f32 f1,f1;
 add.rn.f32 f2,f1,0f3F800000;
 setp.lt.f32 p,f0,0f00000000; @p bra NEGATIVE;
 div.rn.f32 f3,0f3F800000,f2; bra PRODUCT;
NEGATIVE:
 div.rn.f32 f3,f1,f2;
PRODUCT:
 mul.rn.f32 f4,f0,f3; bra STORE;
NEG_INF:
 mov.f32 f4,0f80000000;
STORE:
 st.global.f32 [d4],f4;
DONE:
 ret;
}

.visible .entry rmsnorm(
 .param .u64 a, .param .u64 weight, .param .u64 out,
 .param .u32 rows, .param .u32 width, .param .f64 epsilon
) {
 .reg .pred p;
 .reg .b32 r<10>;
 .reg .b64 d<9>;
 .reg .f32 f<3>;
 .reg .f64 g<8>;
 ld.param.u64 d0,[a]; ld.param.u64 d1,[weight]; ld.param.u64 d2,[out];
 ld.param.u32 r0,[rows]; ld.param.u32 r1,[width]; ld.param.f64 g0,[epsilon];
 mov.u32 r2,%tid.x; mov.u32 r3,%ctaid.x; mov.u32 r4,%ntid.x;
 mad.lo.u32 r5,r3,r4,r2;
 setp.ge.u32 p,r5,r0; @p bra DONE;
 mul.lo.u32 r6,r5,r1;
 mov.u32 r7,0; mov.f64 g1,0d0000000000000000;
SUM:
 setp.ge.u32 p,r7,r1; @p bra INVERSE;
 add.u32 r8,r6,r7; mul.wide.u32 d3,r8,4; add.u64 d4,d0,d3;
 ld.global.f32 f0,[d4]; cvt.f64.f32 g2,f0;
 mul.rn.f64 g3,g2,g2; add.rn.f64 g1,g1,g3;
 add.u32 r7,r7,1; bra SUM;
INVERSE:
 cvt.rn.f64.u32 g4,r1; div.rn.f64 g1,g1,g4; add.rn.f64 g1,g1,g0;
 sqrt.rn.f64 g1,g1; div.rn.f64 g1,0d3FF0000000000000,g1;
 mov.u32 r7,0;
OUTPUT:
 setp.ge.u32 p,r7,r1; @p bra DONE;
 add.u32 r8,r6,r7; mul.wide.u32 d3,r8,4; add.u64 d4,d0,d3;
 add.u64 d5,d2,d3; mul.wide.u32 d6,r7,4; add.u64 d7,d1,d6;
 ld.global.f32 f0,[d4]; ld.global.f32 f1,[d7];
 cvt.f64.f32 g2,f0; cvt.f64.f32 g3,f1;
 mul.rn.f64 g2,g2,g1; mul.rn.f64 g2,g2,g3;
 cvt.rn.f32.f64 f2,g2; st.global.f32 [d5],f2;
 add.u32 r7,r7,1; bra OUTPUT;
DONE:
 ret;
}
