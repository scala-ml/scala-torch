// Materialize one batch/group's input patches as a row-major [K, output_positions] matrix.
.visible .entry im2col(.param .u64 c_x, .param .u64 c_col, .param .u64 c_geometry,
 .param .u32 c_batch, .param .u32 c_group, .param .u32 c_position_start,
