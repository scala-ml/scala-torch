IC_DONE: ret;
}

// One thread per output, Double accumulation in the CPU reference's product order.
.visible .entry conv2d(.param .u64 c_x, .param .u64 c_w, .param .u64 c_out,
 .param .u64 c_geometry, .param .u32 c_count, .param .u32 c_fast) {
 .reg .pred p;
 .reg .u32 ci,h,w,co,cg,kh,kw,oh,ow,sh,sw,ph,pw,dh,dw,groups;
 .reg .u32 count,idx,ox,oy,oc,batch,first,ch,ky,kx,tmp,xi,wi;
 .reg .u64 px,pwgt,pout,pg,addr,offset;
 .reg .s64 iy,ix,coord,tmp64;
 .reg .f32 xf,wf,result;
 .reg .f32 fast_sum;
 .reg .f64 sum,xd,wd,product;
 .reg .u32 fast_mode;
