 mul.wide.u32 tmp64,kx,dw; add.s64 ix,ix,tmp64;
 setp.lt.s64 p,ix,0; @p bra C_NEXT_COL;
 cvt.u64.u32 tmp64,w; setp.ge.s64 p,ix,tmp64; @p bra C_NEXT_COL;
 add.u32 tmp,first,ch; mad.lo.u32 xi,batch,ci,tmp;
 cvt.u32.u64 tmp,iy; mad.lo.u32 xi,xi,h,tmp;
 cvt.u32.u64 tmp,ix; mad.lo.u32 xi,xi,w,tmp;
 mad.lo.u32 wi,oc,cg,ch; mad.lo.u32 wi,wi,kh,ky; mad.lo.u32 wi,wi,kw,kx;
 mul.wide.u32 offset,xi,4; add.u64 addr,px,offset; ld.global.f32 xf,[addr];
 mul.wide.u32 offset,wi,4; add.u64 addr,pwgt,offset; ld.global.f32 wf,[addr];
 setp.ne.u32 p,fast_mode,0; @p bra C_FAST_ACCUM;
 cvt.f64.f32 xd,xf; cvt.f64.f32 wd,wf; mul.rn.f64 product,xd,wd; add.rn.f64 sum,sum,product; bra C_ACCUM_DONE;
C_FAST_ACCUM:
 fma.rn.f32 fast_sum,xf,wf,fast_sum;
C_ACCUM_DONE:
C_NEXT_COL:
 add.u32 kx,kx,1; bra C_COL;
C_NEXT_ROW:
 add.u32 ky,ky,1; bra C_ROW;
C_NEXT_CHANNEL:
 add.u32 ch,ch,1; bra C_CHANNEL;
C_STORE:
 setp.ne.u32 p,fast_mode,0; @p bra C_FAST_STORE;
 cvt.rn.f32.f64 result,sum; bra C_STORE_OUTPUT;
C_FAST_STORE:
 mov.f32 result,fast_sum;
C_STORE_OUTPUT:
 mul.wide.u32 offset,idx,4; add.u64 addr,pout,offset; st.global.f32 [addr],result;
C_DONE: ret;
}

// One thread owns each sample/channel group; biased variance and separate FP32 affine steps.
.visible .entry groupnorm(.param .u64 gn_x,.param .u64 gn_weight,.param .u64 gn_bias,.param .u64 gn_out,
 .param .u32 gn_rows,.param .u32 gn_width,.param .u32 gn_channels,.param .u32 gn_spatial,.param .f64 gn_eps) {
 .reg .pred p;
 .reg .u32 rows,width,channels,spatial,gidx,tmp,start,i,index,channel;
 .reg .u64 px,pw,pb,po,offset,addr;
 .reg .f32 x,result,affine;
 .reg .f64 mean,variance,value,centered,product,denom,inverse,eps;
 ld.param.u64 px,[gn_x]; ld.param.u64 pw,[gn_weight]; ld.param.u64 pb,[gn_bias]; ld.param.u64 po,[gn_out];
 ld.param.u32 rows,[gn_rows]; ld.param.u32 width,[gn_width]; ld.param.u32 channels,[gn_channels];
 ld.param.u32 spatial,[gn_spatial]; ld.param.f64 eps,[gn_eps];
 mov.u32 gidx,%ctaid.x; mov.u32 tmp,%ntid.x; mul.lo.u32 gidx,gidx,tmp;
 mov.u32 tmp,%tid.x; add.u32 gidx,gidx,tmp; setp.ge.u32 p,gidx,rows; @p bra GN_DONE;
 mul.lo.u32 start,gidx,width; cvt.rn.f64.u32 denom,width;
 mov.f64 mean,0d0000000000000000; mov.u32 i,0;
GN_MEAN:
 setp.ge.u32 p,i,width; @p bra GN_VARIANCE_START;
 add.u32 index,start,i; mul.wide.u32 offset,index,4; add.u64 addr,px,offset;
 ld.global.f32 x,[addr]; cvt.f64.f32 value,x; add.rn.f64 mean,mean,value;
 add.u32 i,i,1; bra GN_MEAN;
GN_VARIANCE_START:
 div.rn.f64 mean,mean,denom; mov.f64 variance,0d0000000000000000; mov.u32 i,0;
GN_VARIANCE:
 setp.ge.u32 p,i,width; @p bra GN_OUTPUT_START;
 add.u32 index,start,i; mul.wide.u32 offset,index,4; add.u64 addr,px,offset;
 ld.global.f32 x,[addr]; cvt.f64.f32 value,x; sub.rn.f64 centered,value,mean;
 mul.rn.f64 product,centered,centered; add.rn.f64 variance,variance,product;
 add.u32 i,i,1; bra GN_VARIANCE;
GN_OUTPUT_START:
 div.rn.f64 variance,variance,denom; add.rn.f64 variance,variance,eps;
 sqrt.rn.f64 inverse,variance; div.rn.f64 inverse,0d3FF0000000000000,inverse;
 mov.u32 i,0;
GN_OUTPUT:
 setp.ge.u32 p,i,width; @p bra GN_DONE;
 add.u32 index,start,i; mul.wide.u32 offset,index,4; add.u64 addr,px,offset;
 ld.global.f32 x,[addr]; cvt.f64.f32 value,x; sub.rn.f64 centered,value,mean;
 mul.rn.f64 value,centered,inverse; cvt.rn.f32.f64 result,value;
 div.u32 channel,index,spatial; rem.u32 channel,channel,channels;
 setp.eq.u64 p,pw,0; @p bra GN_BIAS;
 mul.wide.u32 offset,channel,4; add.u64 addr,pw,offset; ld.global.f32 affine,[addr];
 mul.rn.f32 result,result,affine;
GN_BIAS:
 setp.eq.u64 p,pb,0; @p bra GN_STORE;
 mul.wide.u32 offset,channel,4; add.u64 addr,pb,offset; ld.global.f32 affine,[addr];
 add.rn.f32 result,result,affine;
GN_STORE:
 mul.wide.u32 offset,index,4; add.u64 addr,po,offset; st.global.f32 [addr],result;
 add.u32 i,i,1; bra GN_OUTPUT;
GN_DONE: ret;
}

// Preserve the original serial double-precision reduction order, then apply
// the resulting statistics in parallel across the full tensor.
.visible .entry groupnorm_stats(.param .u64 gs_x,.param .u64 gs_stats,
 .param .u32 gs_rows,.param .u32 gs_width,.param .f64 gs_eps) {
 .reg .pred p;
 .reg .u32 rows,width,gidx,tmp,start,i,index;
 .reg .u64 px,ps,offset,addr;
 .reg .f32 x;
 .reg .f64 mean,variance,value,centered,product,denom,inverse,eps;
 ld.param.u64 px,[gs_x]; ld.param.u64 ps,[gs_stats];
 ld.param.u32 rows,[gs_rows]; ld.param.u32 width,[gs_width]; ld.param.f64 eps,[gs_eps];
 mov.u32 gidx,%ctaid.x; mov.u32 tmp,%ntid.x; mul.lo.u32 gidx,gidx,tmp;
 mov.u32 tmp,%tid.x; add.u32 gidx,gidx,tmp; setp.ge.u32 p,gidx,rows; @p bra GS_DONE;
 mul.lo.u32 start,gidx,width; cvt.rn.f64.u32 denom,width;
 mov.f64 mean,0d0000000000000000; mov.u32 i,0;
GS_MEAN:
 setp.ge.u32 p,i,width; @p bra GS_VAR_START;
 add.u32 index,start,i; mul.wide.u32 offset,index,4; add.u64 addr,px,offset;
 ld.global.f32 x,[addr]; cvt.f64.f32 value,x; add.rn.f64 mean,mean,value;
 add.u32 i,i,1; bra GS_MEAN;
GS_VAR_START:
 div.rn.f64 mean,mean,denom; mov.f64 variance,0d0000000000000000; mov.u32 i,0;
GS_VAR:
 setp.ge.u32 p,i,width; @p bra GS_STORE;
 add.u32 index,start,i; mul.wide.u32 offset,index,4; add.u64 addr,px,offset;
 ld.global.f32 x,[addr]; cvt.f64.f32 value,x; sub.rn.f64 centered,value,mean;
 mul.rn.f64 product,centered,centered; add.rn.f64 variance,variance,product;
 add.u32 i,i,1; bra GS_VAR;
GS_STORE:
 div.rn.f64 variance,variance,denom; add.rn.f64 variance,variance,eps;
 sqrt.rn.f64 inverse,variance; div.rn.f64 inverse,0d3FF0000000000000,inverse;
 mul.wide.u32 offset,gidx,16; add.u64 addr,ps,offset; st.global.f64 [addr],mean;
 add.u64 addr,addr,8; st.global.f64 [addr],inverse;
GS_DONE: ret;
}

.visible .entry groupnorm_apply(.param .u64 ga_x,.param .u64 ga_weight,.param .u64 ga_bias,
 .param .u64 ga_out,.param .u64 ga_stats,.param .u32 ga_count,.param .u32 ga_width,
 .param .u32 ga_channels,.param .u32 ga_spatial) {
 .reg .pred p;
 .reg .u32 index,tmp,count,width,channels,spatial,group,channel;
 .reg .u64 px,pw,pb,po,ps,offset,addr;
 .reg .f32 x,result,affine;
 .reg .f64 mean,inverse,value,centered;
 ld.param.u64 px,[ga_x]; ld.param.u64 pw,[ga_weight]; ld.param.u64 pb,[ga_bias];
 ld.param.u64 po,[ga_out]; ld.param.u64 ps,[ga_stats];
 ld.param.u32 count,[ga_count]; ld.param.u32 width,[ga_width];
 ld.param.u32 channels,[ga_channels]; ld.param.u32 spatial,[ga_spatial];
 mov.u32 index,%ctaid.x; mov.u32 tmp,%ntid.x; mul.lo.u32 index,index,tmp;
 mov.u32 tmp,%tid.x; add.u32 index,index,tmp; setp.ge.u32 p,index,count; @p bra GA_DONE;
 div.u32 group,index,width; mul.wide.u32 offset,group,16; add.u64 addr,ps,offset;
 ld.global.f64 mean,[addr]; add.u64 addr,addr,8; ld.global.f64 inverse,[addr];
 mul.wide.u32 offset,index,4; add.u64 addr,px,offset; ld.global.f32 x,[addr];
 cvt.f64.f32 value,x; sub.rn.f64 centered,value,mean; mul.rn.f64 value,centered,inverse;
 cvt.rn.f32.f64 result,value; div.u32 channel,index,spatial; rem.u32 channel,channel,channels;
 setp.eq.u64 p,pw,0; @p bra GA_BIAS;
 mul.wide.u32 offset,channel,4; add.u64 addr,pw,offset; ld.global.f32 affine,[addr]; mul.rn.f32 result,result,affine;
GA_BIAS:
 setp.eq.u64 p,pb,0; @p bra GA_STORE;
 mul.wide.u32 offset,channel,4; add.u64 addr,pb,offset; ld.global.f32 affine,[addr]; add.rn.f32 result,result,affine;
GA_STORE:
 mul.wide.u32 offset,index,4; add.u64 addr,po,offset; st.global.f32 [addr],result;
GA_DONE: ret;
}
