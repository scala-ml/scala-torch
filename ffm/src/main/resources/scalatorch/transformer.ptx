 sub.rn.f32 f3,f3,f5; mul.rn.f32 f3,f3,0f3FB8AA3B; ex2.approx.f32 f3,f3; add.rn.f32 f7,f7,f3; bra MQ_SOFTMAX0_STORE;
MQ_SOFTMAX0_NAN:
 mov.f32 f3,0f00000000;
MQ_SOFTMAX0_STORE:
 st.shared.f32 [d7],f3;
 add.u64 d7,d7,16384; ld.shared.f32 f4,[d7];
 setp.ne.u32 p1,r22,0; @p1 bra MQ_SOFTMAX1_NAN;
 sub.rn.f32 f4,f4,f6; mul.rn.f32 f4,f4,0f3FB8AA3B; ex2.approx.f32 f4,f4; add.rn.f32 f8,f8,f4; bra MQ_SOFTMAX1_STORE;
