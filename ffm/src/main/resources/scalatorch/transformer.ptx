 fma.rn.f64 g4,g4,g2,0d3E5AE64567F544E4;
 fma.rn.f64 g4,g4,g2,0d3E927E4FB7789F5C;
 fma.rn.f64 g4,g4,g2,0d3EC71DE3A556C734;
 fma.rn.f64 g4,g4,g2,0d3EFA01A01A01A01A;
 fma.rn.f64 g4,g4,g2,0d3F2A01A01A01A01A;
 fma.rn.f64 g4,g4,g2,0d3F56C16C16C16C17;
 fma.rn.f64 g4,g4,g2,0d3F81111111111111;
 fma.rn.f64 g4,g4,g2,0d3FA5555555555555;
 fma.rn.f64 g4,g4,g2,0d3FC5555555555555;
 fma.rn.f64 g4,g4,g2,0d3FE0000000000000;
 fma.rn.f64 g4,g4,g2,0d3FF0000000000000;
 fma.rn.f64 g4,g4,g2,0d3FF0000000000000;
 // Split the power of two into normal Double factors, including subnormal exp(x).
 shr.s32 r6,r5,1; sub.s32 r7,r5,r6;
 add.s32 r6,r6,1023; add.s32 r7,r7,1023;
 cvt.u64.u32 d5,r6; cvt.u64.u32 d6,r7;
 shl.b64 d5,d5,52; shl.b64 d6,d6,52;
 mov.b64 g5,d5; mov.b64 g6,d6;
