 div.u32 k,idx,positions; rem.u32 local_position,idx,positions;
 add.u32 position,position_start,local_position;
 div.u32 channel,k,kernel_index; rem.u32 wi,k,kernel_index;
 div.u32 ky,wi,kw; rem.u32 kx,wi,kw;
 rem.u32 ox,position,ow; div.u32 oy,position,ow;
