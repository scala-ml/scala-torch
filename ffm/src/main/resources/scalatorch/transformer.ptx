 ld.param.u32 r0,[count]; ld.param.u32 r1,[heads]; ld.param.u32 r2,[kvheads];
 ld.param.u32 r3,[qtokens]; ld.param.u32 r4,[ktokens]; ld.param.u32 r5,[vwidth];
 ld.param.u32 r6,[storageTokens]; ld.param.u32 r7,[row_offset];
 mov.u32 r8,%tid.x; mov.u32 r9,%ctaid.x; mov.u32 r10,%ntid.x;
 mad.lo.u32 r11,r9,r10,r8; setp.ge.u32 p,r11,r0; @p bra DONE;
 div.u32 r12,r11,r5; rem.u32 r13,r11,r5;
 mul.lo.u32 r14,r12,r4; add.u32 r12,r12,r7;
 div.u32 r15,r12,r3; rem.u32 r16,r15,r1; div.u32 r15,r15,r1;
