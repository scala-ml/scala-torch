 mad.lo.u32 r9,r8,r1,r7;
 mul.wide.u32 d5,r9,4; add.u64 d6,d0,d5;
 mul.wide.u32 d7,r5,4; add.u64 d8,d1,d7;
 ld.global.b32 value,[d6]; st.global.b32 [d8],value;
DONE:
 ret;
}

.visible .entry rope(
 .param .u64 a, .param .u64 out, .param .u64 coefficients,
 .param .u32 pairs, .param .u32 tokens, .param .u32 width
) {
 .reg .pred p;
 .reg .b32 r<12>;
 .reg .b64 d<10>;
