}

// One thread per query/key pair. Dot-product reduction order is unchanged.
.visible .entry attention_scores(
 .param .u64 query, .param .u64 key, .param .u64 scores,
 .param .u32 count, .param .u32 heads, .param .u32 kvheads,
 .param .u32 qtokens, .param .u32 ktokens, .param .u32 width,
 .param .u32 storageTokens, .param .u32 row_offset, .param .f64 scale
) {
 .reg .pred p;
 .reg .b32 r<24>;
 .reg .b64 d<9>;
 .reg .f32 f<2>;
 .reg .f64 g<5>;
 ld.param.u64 d0,[query]; ld.param.u64 d1,[key]; ld.param.u64 d2,[scores];
 ld.param.u32 r0,[count]; ld.param.u32 r1,[heads]; ld.param.u32 r2,[kvheads];
 ld.param.u32 r3,[qtokens]; ld.param.u32 r4,[ktokens]; ld.param.u32 r5,[width];
 ld.param.u32 r6,[storageTokens]; ld.param.u32 r7,[row_offset]; ld.param.f64 g4,[scale];
 mov.u32 r8,%tid.x; mov.u32 r9,%ctaid.x; mov.u32 r10,%ntid.x;
 mad.lo.u32 r11,r9,r10,r8; setp.ge.u32 p,r11,r0; @p bra DONE;
